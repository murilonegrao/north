# Copy to .env and fill in only what you need. Never commit .env.

# Backend settings (prefix NORTH_)
# PostgreSQL URL in SQLAlchemy format (postgresql+psycopg://user:password@host:port/db).
# Compose sets it for the app container; set it to run the backend or the loader on the host.
NORTH_DATABASE_URL=
# URL of the schema owner role, used only by `alembic upgrade head`; falls back to
# NORTH_DATABASE_URL when unset. Compose sets it for the app container.
NORTH_MIGRATION_DATABASE_URL=
# Database wiped and migrated by the backend tests; unset = database tests are skipped.
NORTH_TEST_DATABASE_URL=
# Directory of the web build; optional, web/dist is found automatically.
NORTH_WEB_DIST=

# docker compose (each has a local default; set real values outside a laptop)
# Superuser (psql only), schema owner (migrations) and app role (DML only). The role
# passwords are read by deploy/postgres/init/10-roles.sql when the volume is first created.
NORTH_DB_PASSWORD=
NORTH_OWNER_DB_PASSWORD=
NORTH_APP_DB_PASSWORD=
NORTH_HOST_PORT=
NORTH_DB_HOST_PORT=

# Admin area and worker (record 0006). Compose sets these; production sets them in the manifests.
# Raw official files, written by the worker only (fetched or accepted uploads).
NORTH_RAW_DIR=
# Uploads land here first (the web process writes only here).
NORTH_INCOMING_DIR=
# Largest upload in MiB (Cloudflare cuts bodies at 100 MB).
NORTH_UPLOAD_MAX_MIB=
# Session cookie Secure + __Host- prefix (default true); false only for plain-http local runs.
NORTH_COOKIE_SECURE=
# Second factor (TOTP) required for admin accounts (default true); false only for local runs.
NORTH_ADMIN_REQUIRE_TOTP=
# Header carrying the client address from the edge proxy (cf-connecting-ip behind Cloudflare).
NORTH_CLIENT_IP_HEADER=

# api.data.gov key (College Scorecard API). Optional: ingestion uses the bulk files.
NORTH_API_DATA_GOV_KEY=
