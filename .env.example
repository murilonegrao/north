# Copy to .env and fill in only what you need. Never commit .env.

# Backend settings (prefix NORTH_)
# PostgreSQL URL in SQLAlchemy format; optional until Phase 5.
NORTH_DATABASE_URL=
# Directory of the web build; optional, web/dist is found automatically.
NORTH_WEB_DIST=

# docker compose
NORTH_DB_PASSWORD=
NORTH_HOST_PORT=
NORTH_DB_HOST_PORT=

# api.data.gov key (College Scorecard API). Optional: ingestion uses the bulk files.
NORTH_API_DATA_GOV_KEY=
